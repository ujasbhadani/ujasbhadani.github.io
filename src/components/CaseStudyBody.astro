---
import { emphasisHtml } from "../lib/emphasis";

interface Bullet {
  text: string;
}
interface ParaBlock {
  type: "para";
  heading?: string;
  text: string;
}
interface ListBlock {
  type: "list";
  heading?: string;
  ordered: boolean;
  items: Bullet[];
}
interface Props {
  blocks: (ParaBlock | ListBlock)[];
}
const { blocks } = Astro.props;
---

<div class="prose">
  {blocks.map((block) => (
    <div class="case-block">
      {block.heading ? <h3>{block.heading}</h3> : null}
      {block.type === "para" ? (
        <p>{block.text}</p>
      ) : block.ordered ? (
        <ol class="case-list">
          {block.items.map((item) => (
            <li set:html={emphasisHtml(item.text)} />
          ))}
        </ol>
      ) : (
        <ul class="case-list">
          {block.items.map((item) => (
            <li set:html={emphasisHtml(item.text)} />
          ))}
        </ul>
      )}
    </div>
  ))}
</div>
