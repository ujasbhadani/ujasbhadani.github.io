---
interface Bullet {
  text: string;
}
interface Group {
  label?: string;
  bullets: Bullet[];
}
interface Link {
  label: string;
  url: string;
}
interface Props {
  title: string;
  org: string;
  location?: string;
  subline?: string;
  dates?: string;
  groups: Group[];
  links?: Link[];
}
const { title, org, location, subline, dates, groups, links } = Astro.props;
const metaParts = [org, location].filter(Boolean);
---

<div class="timeline-entry">
  <h3>{title}</h3>
  <p class="timeline-meta">
    {metaParts.join(" · ")}
    {dates ? <span class="tab-nums"> · {dates}</span> : null}
    {subline ? <><br />{subline}</> : null}
  </p>
  {groups.map((group) => (
    <>
      {group.label ? <p class="timeline-group-label">{group.label}</p> : null}
      <ul class="bullet-list">
        {group.bullets.map((bullet) => (
          <li>{bullet.text}</li>
        ))}
      </ul>
    </>
  ))}
  {links && links.length ? (
    <p class="timeline-links">
      Links:{" "}
      {links.map((link, i) => (
        <>
          <a href={link.url}>{link.label}</a>
          {i < links.length - 1 ? " · " : null}
        </>
      ))}
    </p>
  ) : null}
</div>
