---
const email = "contact@ujasbhadani.com";
---

<div class="contact-row">
  <span id="contact-email" class="contact-email">{email}</span>
  <button id="copy-email-btn" class="copy-button" type="button" data-email={email}>
    Copy
  </button>
  <a href="https://www.linkedin.com/in/ujasbhadani/">LinkedIn</a>
  <span id="copy-status" class="visually-hidden" role="status" aria-live="polite"></span>
</div>

<script>
  const button = document.getElementById("copy-email-btn");
  const status = document.getElementById("copy-status");
  const emailSpan = document.getElementById("contact-email");

  const selectEmailText = () => {
    if (!emailSpan) return;
    const range = document.createRange();
    range.selectNodeContents(emailSpan);
    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
  };

  const announce = (message: string) => {
    if (status) status.textContent = message;
  };

  if (button) {
    const email = button.getAttribute("data-email") || "";

    // If the Clipboard API isn't available at all, don't offer a button
    // that silently fails on click.
    if (!navigator.clipboard) {
      button.textContent = "Select";
    }

    button.addEventListener("click", async () => {
      if (navigator.clipboard) {
        try {
          await navigator.clipboard.writeText(email);
          const original = button.textContent;
          button.textContent = "Copied";
          announce("Email copied to clipboard");
          window.setTimeout(() => {
            button.textContent = original;
          }, 2000);
          return;
        } catch {
          // fall through to the selection fallback below
        }
      }
      selectEmailText();
      button.textContent = "Select";
      announce("Clipboard unavailable — email text selected, copy manually");
    });
  }
</script>
