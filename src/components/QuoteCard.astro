---
interface Props {
  name: string;
  title: string;
  linkedin: string;
  image: string;
  quote: string;
}
const { name, title, linkedin, image, quote } = Astro.props;
---

<figure class="quote-card">
  <div class="quote-person">
    <img class="quote-photo" src={image} alt={name} width="48" height="48" />
    <figcaption>
      <span class="quote-person-name">{name}</span>
      <a class="quote-person-title" href={linkedin}>{title}</a>
    </figcaption>
  </div>
  <blockquote>
    <span class="quote-mark" aria-hidden="true">&ldquo;</span>
    <p>{quote}</p>
  </blockquote>
</figure>
