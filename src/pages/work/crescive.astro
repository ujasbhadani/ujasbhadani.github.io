---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudyHeader from "../../components/CaseStudyHeader.astro";
import CaseStudyBody from "../../components/CaseStudyBody.astro";

const caseStudy = await getEntry("caseStudies", "crescive");

if (!caseStudy) {
  throw new Error("Missing crescive case study content entry");
}

const title = "Crescive: an AI product built with audit gates · Ujas Bhadani";
const description =
  "Case study: how Crescive, an AI-agent-based Answer Engine Optimization platform, is built with database-enforced tenant isolation and a Risk Officer gate on every security change.";
---

<BaseLayout title={title} description={description} path="/work/crescive/">
  <CaseStudyHeader eyebrow={caseStudy.data.eyebrow} title={caseStudy.data.title} />
  <CaseStudyBody blocks={caseStudy.data.blocks} />
  {caseStudy.data.links && caseStudy.data.links.length ? (
    <p class="case-links">
      {caseStudy.data.links.map((link) => (
        <a href={link.url}>{link.label}</a>
      ))}
    </p>
  ) : null}
</BaseLayout>
