---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Page not found · Ujas Bhadani";
const description = "The page you're looking for doesn't exist. Use the navigation to find what you need.";
---

<BaseLayout title={title} description={description} path="/404/">
  <div class="not-found">
    <h1>Page not found</h1>
    <p>That page doesn't exist. Use the navigation to get back to something real.</p>
  </div>
</BaseLayout>
